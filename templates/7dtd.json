{
  "id": "7dtd",
  "name": "七日杀 7 Days to Die",
  "description": "7 Days to Die 专用服务器（V2/V3 系版本）。配置为 serverconfig.xml（GUI 全量可配），控制台命令走 telnet 管理口，支持文件夹式 Mod 管理与 NexusMods 在线安装。",
  "steam_app_id": 294420,
  "anonymous_login": true,
  "executable": "./7DaysToDieServer.x86_64",
  "default_args": [
    "-quit",
    "-batchmode",
    "-nographics",
    "-dedicated",
    "-configfile=serverconfig.xml"
  ],
  "stop_mode": "rcon",
  "stop_warn_secs": 10,
  "rcon": {
    "type": "telnet",
    "config_path": "serverconfig.xml"
  },
  "console_buttons": [
    {
      "label": "在线玩家",
      "command": "lp"
    },
    {
      "label": "立即存档",
      "command": "saveworld"
    },
    {
      "label": "沙盒选项",
      "command": "gso"
    },
    {
      "label": "广播…",
      "command": "say",
      "prompt": "广播内容（发给全服玩家）:"
    },
    {
      "label": "游戏时间",
      "command": "time"
    },
    {
      "label": "踢人…",
      "command": "kick",
      "prompt": "玩家名（可加原因）:"
    },
    {
      "label": "封禁…",
      "command": "ban",
      "prompt": "玩家名:"
    },
    {
      "label": "内存",
      "command": "mem"
    },
    {
      "label": "帮助",
      "command": "help"
    }
  ],
  "ports": [
    {
      "key": "game",
      "default": 26900,
      "proto": "tcp",
      "desc": "游戏端口（26900 TCP+UDP 都要用；26902 UDP 为 EOS 联机，需一并放行）",
      "public": true
    }
  ],
  "configs": [
    {
      "path": "serverconfig.xml",
      "format": "xmlkv",
      "seed_from": "serverconfig.xml",
      "label": "服务器配置 (serverconfig.xml)",
      "schema": [
        {
          "key": "ServerName",
          "label": "服务器名称",
          "group": "基础信息",
          "type": "string",
          "default": "My Game Host",
          "desc": "服务器在游戏大厅列表里显示的名字。"
        },
        {
          "key": "ServerDescription",
          "label": "服务器描述",
          "group": "基础信息",
          "type": "string",
          "default": "A 7 Days to Die server",
          "desc": "服务器列表里展示的简介文字。"
        },
        {
          "key": "ServerWebsiteURL",
          "label": "官网 / 群地址",
          "group": "基础信息",
          "type": "string",
          "default": "",
          "desc": "服务器列表里可点击的链接，填你的官网/群/论坛地址，留空则不显示。"
        },
        {
          "key": "ServerPassword",
          "label": "进入服务器密码",
          "group": "基础信息",
          "type": "password",
          "default": "",
          "desc": "玩家进入服务器需要输入的密码；留空 = 不需要密码。"
        },
        {
          "key": "ServerLoginConfirmationText",
          "label": "进服确认公告",
          "group": "基础信息",
          "type": "string",
          "default": "",
          "desc": "玩家进入时弹出的确认文字（如规则、免责声明），玩家需点确认才能进入；留空 = 不弹。"
        },
        {
          "key": "Region",
          "label": "服务器地区",
          "group": "基础信息",
          "type": "select",
          "default": "NorthAmericaEast",
          "options": [
            "NorthAmericaEast",
            "NorthAmericaWest",
            "CentralAmerica",
            "SouthAmerica",
            "Europe",
            "Russia",
            "Asia",
            "MiddleEast",
            "Africa",
            "Oceania"
          ],
          "desc": "服务器所在地区，影响大厅列表的区域分类。国内一般选 Asia。"
        },
        {
          "key": "Language",
          "label": "服务器语言",
          "group": "基础信息",
          "type": "string",
          "default": "English",
          "desc": "服务器主要语言，玩家搜索时会用到。填语言英文名（如 Chinese、English）。"
        },
        {
          "key": "ServerPort",
          "label": "游戏端口",
          "group": "网络",
          "type": "int",
          "default": 26900,
          "min": 1,
          "max": 65535,
          "desc": "服务器监听端口。官方建议用 26900-26905 或 27015-27020 区间（局域网发现需要）。注意：改这里需与实例端口设置、防火墙/安全组保持一致。"
        },
        {
          "key": "ServerVisibility",
          "label": "大厅可见性",
          "group": "网络",
          "type": "select",
          "default": "2",
          "options": [
            "2",
            "1",
            "0"
          ],
          "desc": "2 = 公开（大厅可搜到，推荐）；1 = 仅好友可见（专用服务器没好友意义不大，等于需 IP 直连）；0 = 不公开（只能 IP 直连）。"
        },
        {
          "key": "ServerDisabledNetworkProtocols",
          "label": "禁用的网络协议",
          "group": "网络",
          "type": "select",
          "default": "SteamNetworking",
          "options": [
            "SteamNetworking",
            "LiteNetLib",
            "LiteNetLib,SteamNetworking",
            ""
          ],
          "desc": "逗号分隔可选 LiteNetLib / SteamNetworking。服务器与玩家之间没有 NAT 路由器或已正确端口转发时，官方建议禁用 SteamNetworking（默认值）；此项改动重启生效。"
        },
        {
          "key": "ServerMaxWorldTransferSpeedKiBs",
          "label": "世界传输限速 KiB/s",
          "group": "网络",
          "type": "int",
          "default": 512,
          "min": 0,
          "max": 1300,
          "desc": "新玩家首次进服下载世界的最大速度（KiB/s）。上限约 1300，设更高也到不了。调大加快进服但占带宽。"
        },
        {
          "key": "ServerMaxPlayerCount",
          "label": "最大玩家数",
          "group": "玩家位",
          "type": "int",
          "default": 8,
          "desc": "同时在线人数上限。开跨平台（ServerAllowCrossplay）时官方要求默认或更少的槽位数。"
        },
        {
          "key": "ServerReservedSlots",
          "label": "保留位数量",
          "group": "玩家位",
          "type": "int",
          "default": 0,
          "desc": "从最大玩家数中预留出来、只有特定权限等级玩家可用的槽位数。0 = 不预留。"
        },
        {
          "key": "ServerReservedSlotsPermission",
          "label": "保留位所需权限",
          "group": "玩家位",
          "type": "int",
          "default": 100,
          "desc": "使用保留位所需的最低权限等级（0-1000，数字越小权限越高；普通玩家 1000、管理员 0）。默认 100 ≈ 仅管理员/受信用户可用；想让所有普通玩家都能用保留位则设 1000。"
        },
        {
          "key": "ServerAdminSlots",
          "label": "管理员溢出位",
          "group": "玩家位",
          "type": "int",
          "default": 0,
          "desc": "服务器满员时额外允许进入的管理员数量。0 = 不留。"
        },
        {
          "key": "ServerAdminSlotsPermission",
          "label": "溢出位所需权限",
          "group": "玩家位",
          "type": "int",
          "default": 0,
          "desc": "使用管理员溢出位所需的最低权限等级（0 = 仅管理员）。"
        },
        {
          "key": "WebDashboardEnabled",
          "label": "Web 面板",
          "group": "管理接口",
          "type": "select",
          "default": "false",
          "options": [
            "true",
            "false"
          ],
          "desc": "是否启用游戏自带的 Web 控制面板。GSPanel 已提供控制台，一般保持关闭。"
        },
        {
          "key": "WebDashboardPort",
          "label": "Web 面板端口",
          "group": "管理接口",
          "type": "int",
          "default": 8080,
          "desc": "Web 面板监听端口（启用 Web 面板时才生效）。"
        },
        {
          "key": "WebDashboardUrl",
          "label": "Web 面板外网地址",
          "group": "管理接口",
          "type": "string",
          "default": "",
          "desc": "Web 面板经反向代理等外部访问时的完整 URL（如 https://domain.tld:1234/）；直接 IP 访问可留空。"
        },
        {
          "key": "EnableMapRendering",
          "label": "地图渲染",
          "group": "管理接口",
          "type": "select",
          "default": "false",
          "options": [
            "true",
            "false"
          ],
          "desc": "探索时把地图渲染成图片瓦片（Web 面板的地图展示依赖它）。不开省性能。"
        },
        {
          "key": "TelnetEnabled",
          "label": "Telnet 控制台",
          "group": "管理接口",
          "type": "select",
          "default": "true",
          "options": [
            "true",
            "false"
          ],
          "desc": "telnet 管理接口开关。GSPanel 的控制台命令、优雅停服都依赖它，保持开启。"
        },
        {
          "key": "TelnetPort",
          "label": "Telnet 端口",
          "group": "管理接口",
          "type": "int",
          "default": 8081,
          "desc": "telnet 管理接口监听端口。面板从本机回环连接，不需要对外开放。"
        },
        {
          "key": "TelnetPassword",
          "label": "Telnet 密码",
          "group": "管理接口",
          "type": "password",
          "default": "",
          "note": "强烈建议留空（仅本机可连，面板功能完全可用且最安全）",
          "desc": "telnet 管理口密码。⚠️ 留空时游戏只监听本机回环（最安全，面板走 127.0.0.1）；设置密码后 telnet 会监听所有网卡，需自行做好防火墙并妥善保管密码。"
        },
        {
          "key": "TelnetFailedLoginLimit",
          "label": "Telnet 允许错次",
          "group": "管理接口",
          "type": "int",
          "default": 10,
          "desc": "同一客户端密码输错这么多次后拉黑。"
        },
        {
          "key": "TelnetFailedLoginsBlocktime",
          "label": "Telnet 拉黑时长（秒）",
          "group": "管理接口",
          "type": "int",
          "default": 10,
          "desc": "被拉黑的客户端需要等待的解封时间（秒）。"
        },
        {
          "key": "TerminalWindowEnabled",
          "label": "本地终端窗口",
          "group": "管理接口",
          "type": "select",
          "default": "true",
          "options": [
            "true",
            "false"
          ],
          "desc": "是否弹出本地终端窗口用于看日志/输命令（仅 Windows 有影响；Linux 专用服务器无效果）。"
        },
        {
          "key": "AdminFileName",
          "label": "管理员名单文件",
          "group": "管理接口",
          "type": "string",
          "default": "serveradmin.xml",
          "desc": "管理员权限配置文件名（相对于 Saves 目录）。在游戏内用 admin 命令或直接编辑该文件授权。"
        },
        {
          "key": "ServerAllowCrossplay",
          "label": "允许跨平台",
          "group": "联机与反作弊",
          "type": "select",
          "default": "false",
          "options": [
            "true",
            "false"
          ],
          "desc": "是否允许 PC/主机跨平台联机。开启后只有未被平台制裁（IgnoreEOSSanctions 开启或玩家干净）的玩家可搜到/加入，且对人数槽位有默认或更低的要求。"
        },
        {
          "key": "EACEnabled",
          "label": "EasyAntiCheat 反作弊",
          "group": "联机与反作弊",
          "type": "select",
          "default": "true",
          "options": [
            "true",
            "false"
          ],
          "desc": "是否启用 EAC 反作弊。关闭后纯净客户端也能进，但外挂风险大增；默认开启。"
        },
        {
          "key": "IgnoreEOSSanctions",
          "label": "忽略 EOS 制裁",
          "group": "联机与反作弊",
          "type": "select",
          "default": "false",
          "options": [
            "true",
            "false"
          ],
          "desc": "是否允许被 EOS 平台制裁（封禁记录）的玩家加入。一般保持关闭。"
        },
        {
          "key": "HideCommandExecutionLog",
          "label": "隐藏命令执行日志",
          "group": "存档与区块",
          "type": "select",
          "default": "0",
          "options": [
            "0",
            "1",
            "2",
            "3"
          ],
          "desc": "命令执行记录的隐藏级别：0 = 全部显示；1 = 对 Telnet/控制面板隐藏；2 = 还对远程游戏客户端隐藏；3 = 全部隐藏。"
        },
        {
          "key": "MaxUncoveredMapChunksPerPlayer",
          "label": "每人地图揭示上限",
          "group": "存档与区块",
          "type": "int",
          "default": 131072,
          "desc": "每个玩家地图最多可揭开的区块数（每块 256m²，文件占 512 字节）。默认 131072 = 最多揭示 32 km²，控制地图文件体积。"
        },
        {
          "key": "PersistentPlayerProfiles",
          "label": "固定玩家档案",
          "group": "存档与区块",
          "type": "select",
          "default": "false",
          "options": [
            "true",
            "false"
          ],
          "desc": "false = 玩家进服可任选角色档案；true = 强制使用上次进服的档案（防小号/换档刷物品）。"
        },
        {
          "key": "MaxChunkAge",
          "label": "区块重置天数",
          "group": "存档与区块",
          "type": "int",
          "default": -1,
          "desc": "多少个游戏日内没被访问的区块恢复原始状态（-1 = 永不重置）。领地石/睡袋保护范围内的区块不受影响。"
        },
        {
          "key": "SaveDataLimit",
          "label": "存档空间上限 MB",
          "group": "存档与区块",
          "type": "int",
          "default": -1,
          "desc": "单个存档允许占用的最大磁盘空间（MB），超限会强制重置部分区块回收空间；负数 = 不限制。"
        },
        {
          "key": "GameWorld",
          "label": "世界",
          "group": "世界与存档",
          "type": "string",
          "default": "Navezgane",
          "note": "与 WorldGenSeed/WorldGenSize/GameName 同属存档标识，改动 = 另开新存档",
          "desc": "使用哪个世界：\"RWG\" = 按种子随机生成（见下面的种子/尺寸）；或填 Worlds 目录里已有的世界名（如 Navezgane、Pregen06k01、Pregen08k01 等预生成世界）。"
        },
        {
          "key": "WorldGenSeed",
          "label": "随机世界种子",
          "group": "世界与存档",
          "type": "string",
          "default": "MyGame",
          "desc": "GameWorld=RWG 时生成世界的随机种子；同名世界已存在则直接加载。只影响 RWG 世界的地形。"
        },
        {
          "key": "WorldGenSize",
          "label": "随机世界尺寸",
          "group": "世界与存档",
          "type": "select",
          "default": "6144",
          "options": [
            "6144",
            "8192",
            "10240"
          ],
          "desc": "RWG 世界的边长（格）。官方支持 6144/8192/10240（2048 的倍数）。越大生成越慢、存档越大。"
        },
        {
          "key": "GameName",
          "label": "存档名",
          "group": "世界与存档",
          "type": "string",
          "default": "MyGame",
          "note": "改动 = 另开新存档",
          "desc": "存档名称（允许字母数字 _-. ），决定存档目录名，也影响树木等装饰物的放置种子；不控制 RWG 地形。"
        },
        {
          "key": "GameMode",
          "label": "游戏模式",
          "group": "世界与存档",
          "type": "select",
          "default": "GameModeSurvival",
          "options": [
            "GameModeSurvival"
          ],
          "desc": "游戏模式，官方目前只有生存模式 GameModeSurvival。"
        },
        {
          "key": "PlayerSafeZoneLevel",
          "label": "新手保护等级",
          "group": "难度与安全区",
          "type": "int",
          "default": 5,
          "desc": "等级小于等于该值的新玩家出生时自带安全区（周围不刷怪）。"
        },
        {
          "key": "PlayerSafeZoneHours",
          "label": "新手保护时长（小时）",
          "group": "难度与安全区",
          "type": "int",
          "default": 5,
          "desc": "新手安全区在游戏时间里持续多少小时。"
        },
        {
          "key": "SandboxCode",
