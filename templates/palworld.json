{
  "id": "palworld",
  "name": "幻兽帕鲁 Palworld",
  "description": "Palworld 专用服务器（Linux）。首次安装后建议通过「配置」修改服务器名与管理员密码。",
  "steam_app_id": 2394010,
  "anonymous_login": true,
  "executable": "./PalServer.sh",
  "default_args": ["-useperfthreads", "-NoAsyncLoadingThread", "-UseMultithreadForDS"],
  "stop_mode": "rcon",
  "stop_warn_secs": 10,
  "rcon": { "type": "source", "port_key": "rcon" },
  "ports": [
    { "key": "game", "default": 8211, "proto": "udp", "desc": "游戏端口（玩家连接）", "public": true },
    { "key": "rcon", "default": 25575, "proto": "tcp", "desc": "RCON 远程管理（仅本机使用即可）", "public": false }
  ],
  "configs": [
    {
      "path": "Pal/Saved/Config/LinuxServer/PalWorldSettings.ini",
      "format": "option-settings",
      "seed_from": "DefaultPalWorldSettings.ini",
      "label": "服务器设置 (PalWorldSettings.ini)",
      "schema": [
        { "key": "ServerName", "label": "服务器名称", "type": "string", "default": "Default Palworld Server" },
        { "key": "ServerDescription", "label": "服务器简介", "type": "string" },
        { "key": "AdminPassword", "label": "管理员密码(RCON同用)", "type": "password" },
        { "key": "ServerPassword", "label": "加入密码(留空=公开)", "type": "password" },
        { "key": "ServerPlayerMaxNum", "label": "最大玩家数", "type": "int", "default": 32, "min": 1, "max": 32, "note": "32 为游戏硬上限" },
        { "key": "PublicPort", "label": "游戏端口", "type": "int", "default": 8211, "min": 1, "max": 65535 },
        { "key": "RCONEnabled", "label": "启用RCON", "type": "bool" },
        { "key": "RCONPort", "label": "RCON端口", "type": "int", "default": 25575, "min": 1, "max": 65535 },
        { "key": "Region", "label": "区域", "type": "string" },
        { "key": "bUseAuth", "label": "启用封禁验证", "type": "bool" },
        { "key": "DayTimeSpeedRate", "label": "白天流速", "type": "float", "default": 1.0 },
        { "key": "NightTimeSpeedRate", "label": "夜晚流速", "type": "float", "default": 1.0 },
        { "key": "ExpRate", "label": "经验倍率", "type": "float", "default": 1.0 },
        { "key": "PalCaptureRate", "label": "帕鲁捕获率", "type": "float", "default": 1.0 },
        { "key": "PalSpawnNumRate", "label": "帕鲁刷新倍率", "type": "float", "default": 1.0, "note": "官方注明：调高会显著增加服务器负载" },
        { "key": "PalDamageRateAttack", "label": "帕鲁攻击倍率", "type": "float", "default": 1.0 },
        { "key": "PalDamageRateDefense", "label": "帕鲁防御倍率", "type": "float", "default": 1.0 },
        { "key": "PlayerDamageRateAttack", "label": "玩家攻击倍率", "type": "float", "default": 1.0 },
        { "key": "PlayerDamageRateDefense", "label": "玩家防御倍率", "type": "float", "default": 1.0 },
        { "key": "CollectionDropRate", "label": "采集掉落倍率", "type": "float", "default": 1.0 },
        { "key": "DropItemMaxNum", "label": "掉落物上限", "type": "int", "default": 3000 },
        { "key": "DeathPenalty", "label": "死亡惩罚", "type": "select", "options": ["None", "Item", "ItemAndEquipment", "All"], "default": "Item" },
        { "key": "bEnablePlayerToPlayerDamage", "label": "玩家间伤害", "type": "bool" },
        { "key": "bEnableFriendlyFire", "label": "友军伤害", "type": "bool" },
        { "key": "bIsPvP", "label": "PvP模式", "type": "bool" },
        { "key": "bCanPickupOtherGuildDeathPenaltyDrop", "label": "可拾取他人工会死亡掉落", "type": "bool" },
        { "key": "GuildPlayerMaxNum", "label": "工会人数上限", "type": "int", "default": 20 },
        { "key": "BaseCampMaxNum", "label": "据点上限", "type": "int", "default": 128 },
        { "key": "BaseCampWorkerMaxNum", "label": "据点工作帕鲁上限", "type": "int", "default": 15, "note": "官方已知问题：调大可能不生效" },
        { "key": "bIsRandomizerPalLevelRandom", "label": "帕鲁等级随机", "type": "bool", "note": "需创建新世界才生效" },
        { "key": "EnablePredatorBossPal", "label": "启用掠食者BOSS", "type": "bool" }
      ]
    }
  ],
  "backup_paths": ["Pal/Saved"],
  "world_paths": ["Pal/Saved/SaveGames"],
  "notes": "内存需求高（官方建议16G+），务必配置每日定时重启。所有设置（含经验/掉落等倍率）重启服务器即生效，无需新建世界；仅随机化相关（如「帕鲁等级随机」）在创建世界时固化。公网需放行游戏端口 UDP。倍率类参数无官方上下限。"
}
