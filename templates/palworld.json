{
  "id": "palworld",
  "name": "幻兽帕鲁 Palworld",
  "description": "Palworld 专用服务器（Linux）。首次安装后建议通过「配置」修改服务器名与管理员密码。",
  "steam_app_id": 2394010,
  "anonymous_login": true,
  "executable": "./PalServer.sh",
  "default_args": ["-useperfthreads", "-NoAsyncLoadingThread", "-UseMultithreadForDS"],
  "stop_mode": "rcon",
  "stop_warn_secs": 10,
  "rcon": { "type": "source", "port_key": "rcon" },
  "ports": [
    { "key": "game", "default": 8211, "proto": "udp", "desc": "游戏端口（玩家连接）", "public": true },
    { "key": "rcon", "default": 25575, "proto": "tcp", "desc": "RCON 远程管理（仅本机使用即可）", "public": false }
  ],
  "configs": [
    {
      "path": "Pal/Saved/Config/LinuxServer/PalWorldSettings.ini",
      "format": "option-settings",
      "seed_from": "DefaultPalWorldSettings.ini",
      "label": "服务器设置 (PalWorldSettings.ini)",
      "schema": [
        { "key": "ServerName", "label": "服务器名称", "type": "string" },
        { "key": "ServerDescription", "label": "服务器简介", "type": "string" },
        { "key": "AdminPassword", "label": "管理员密码(RCON同用)", "type": "password" },
        { "key": "ServerPassword", "label": "加入密码(留空=公开)", "type": "password" },
        { "key": "ServerPlayerMaxNum", "label": "最大玩家数", "type": "int" },
        { "key": "PublicPort", "label": "游戏端口", "type": "int" },
        { "key": "RCONEnabled", "label": "启用RCON", "type": "bool" },
        { "key": "RCONPort", "label": "RCON端口", "type": "int" },
        { "key": "Region", "label": "区域", "type": "string" },
        { "key": "bUseAuth", "label": "启用封禁验证", "type": "bool" },
        { "key": "DayTimeSpeedRate", "label": "白天流速", "type": "float" },
        { "key": "NightTimeSpeedRate", "label": "夜晚流速", "type": "float" },
        { "key": "ExpRate", "label": "经验倍率", "type": "float" },
        { "key": "PalCaptureRate", "label": "帕鲁捕获率", "type": "float" },
        { "key": "PalSpawnNumRate", "label": "帕鲁刷新倍率", "type": "float" },
        { "key": "PalDamageRateAttack", "label": "帕鲁攻击倍率", "type": "float" },
        { "key": "PalDamageRateDefense", "label": "帕鲁防御倍率", "type": "float" },
        { "key": "PlayerDamageRateAttack", "label": "玩家攻击倍率", "type": "float" },
        { "key": "PlayerDamageRateDefense", "label": "玩家防御倍率", "type": "float" },
        { "key": "CollectionDropRate", "label": "采集掉落倍率", "type": "float" },
        { "key": "DropItemMaxNum", "label": "掉落物上限", "type": "int" },
        { "key": "DeathPenalty", "label": "死亡惩罚", "type": "select", "options": ["None", "Item", "ItemAndEquipment", "All"] },
        { "key": "bEnablePlayerToPlayerDamage", "label": "玩家间伤害", "type": "bool" },
        { "key": "bEnableFriendlyFire", "label": "友军伤害", "type": "bool" },
        { "key": "bIsPvP", "label": "PvP模式", "type": "bool" },
        { "key": "bCanPickupOtherGuildDeathPenaltyDrop", "label": "可拾取他人工会死亡掉落", "type": "bool" },
        { "key": "GuildPlayerMaxNum", "label": "工会人数上限", "type": "int" },
        { "key": "BaseCampMaxNum", "label": "据点上限", "type": "int" },
        { "key": "BaseCampWorkerMaxNum", "label": "据点工作帕鲁上限", "type": "int" },
        { "key": "bIsRandomizerPalLevelRandom", "label": "帕鲁等级随机", "type": "bool" },
        { "key": "EnablePredatorBossPal", "label": "启用掠食者BOSS", "type": "bool" }
      ]
    }
  ],
  "backup_paths": ["Pal/Saved"],
  "notes": "内存需求高（官方建议16G+），务必配置每日定时重启。经验倍率等「世界参数」在创建世界时固化进存档，改配置只对新世界生效（需删存档重建）；服务器名/密码/端口等每次启动生效。公网需放行游戏端口 UDP。"
}
