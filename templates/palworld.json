{
  "id": "palworld",
  "name": "幻兽帕鲁 Palworld",
  "description": "Palworld 专用服务器（Linux）。首次安装后建议通过「配置」修改服务器名与管理员密码。",
  "steam_app_id": 2394010,
  "anonymous_login": true,
  "executable": "./PalServer.sh",
  "default_args": ["-useperfthreads", "-NoAsyncLoadingThread", "-UseMultithreadForDS"],
  "stop_mode": "rcon",
  "stop_warn_secs": 10,
  "rcon": { "type": "source", "port_key": "rcon" },
  "rest_api": {
    "port_key": "rest",
    "commands": {
      "ShowPlayers": { "method": "GET", "path": "/v1/api/players", "format": "players" },
      "Info": { "method": "GET", "path": "/v1/api/info", "format": "kv" },
      "Metrics": { "method": "GET", "path": "/v1/api/metrics", "format": "metrics" },
      "Broadcast": { "method": "POST", "path": "/v1/api/announce", "body": { "message": "$arg" } },
      "KickPlayer": { "method": "POST", "path": "/v1/api/kick", "body": { "userid": "$arg", "message": "Kicked by admin" } },
      "BanPlayer": { "method": "POST", "path": "/v1/api/ban", "body": { "userid": "$arg", "message": "Banned by admin" } }
    }
  },
  "console_buttons": [
    { "label": "在线玩家", "command": "ShowPlayers" },
    { "label": "服务器信息", "command": "Info" },
    { "label": "性能指标", "command": "Metrics" },
    { "label": "立即存档", "command": "Save" },
    { "label": "广播…", "command": "Broadcast", "prompt": "广播内容:" },
    { "label": "踢出玩家…", "command": "KickPlayer", "prompt": "输入要踢出的玩家 userid（点「在线玩家」可查看，steam_ 开头）:" },
    { "label": "封禁玩家…", "command": "BanPlayer", "prompt": "警告：封禁后该玩家无法再加入！\n输入要封禁的玩家 userid（steam_ 开头）:" }
  ],
  "ports": [
    { "key": "game", "default": 8211, "proto": "udp", "desc": "游戏端口（玩家连接）", "public": true },
    { "key": "rcon", "default": 25575, "proto": "tcp", "desc": "RCON 远程管理（仅本机使用即可）", "public": false },
    { "key": "rest", "default": 8212, "proto": "tcp", "desc": "REST API（ShowPlayers/Info 走此接口，仅本机使用即可）", "public": false }
  ],
  "configs": [
    {
      "path": "Pal/Saved/Config/LinuxServer/PalWorldSettings.ini",
      "format": "option-settings",
      "seed_from": "DefaultPalWorldSettings.ini",
      "label": "服务器设置 (PalWorldSettings.ini)",
      "schema": [
        { "key": "ServerName", "group": "基础设置", "label": "服务器名称", "type": "string", "default": "Default Palworld Server" },
        { "key": "ServerDescription", "group": "基础设置", "label": "服务器简介", "type": "string" },
        { "key": "AdminPassword", "group": "基础设置", "label": "管理员密码(RCON同用)", "type": "password" },
        { "key": "ServerPassword", "group": "基础设置", "label": "加入密码(留空=公开)", "type": "password" },
        { "key": "ServerPlayerMaxNum", "group": "基础设置", "label": "最大玩家数", "type": "int", "default": 32, "min": 1, "max": 32, "note": "32 为游戏硬上限" },
        { "key": "CoopPlayerMaxNum", "group": "基础设置", "label": "合作模式最大玩家数", "type": "int", "default": 4, "note": "仅合作模式(邀请码)有效，专用服务器无效" },
        { "key": "PublicPort", "group": "基础设置", "label": "游戏端口", "type": "int", "default": 8211, "min": 1, "max": 65535 },
        { "key": "PublicIP", "group": "基础设置", "label": "公网IP", "type": "string", "note": "留空=自动检测" },
        { "key": "RCONEnabled", "group": "基础设置", "label": "启用RCON", "type": "bool" },
        { "key": "RCONPort", "group": "基础设置", "label": "RCON端口", "type": "int", "default": 25575, "min": 1, "max": 65535 },
        { "key": "RESTAPIEnabled", "group": "基础设置", "label": "启用REST API", "type": "bool" },
        { "key": "RESTAPIPort", "group": "基础设置", "label": "REST API端口", "type": "int", "default": 8212, "min": 1, "max": 65535 },
        { "key": "Region", "group": "基础设置", "label": "区域", "type": "string" },
        { "key": "bUseAuth", "group": "基础设置", "label": "启用封禁验证", "type": "bool" },
        { "key": "BanListURL", "group": "基础设置", "label": "封禁名单URL", "type": "string" },
        { "key": "bAllowClientMod", "group": "基础设置", "label": "允许客户端Mod", "type": "bool" },
        { "key": "bShowPlayerList", "group": "基础设置", "label": "允许玩家列表查询", "type": "bool" },
        { "key": "ChatPostLimitPerMinute", "group": "基础设置", "label": "每分钟发言上限", "type": "int", "default": 30 },
        { "key": "bIsShowJoinLeftMessage", "group": "基础设置", "label": "显示加入/离开消息", "type": "bool" },
        { "key": "LogFormatType", "group": "基础设置", "label": "日志格式", "type": "select", "options": ["Text", "Json"], "default": "Text" },
        { "key": "AutoSaveSpan", "group": "基础设置", "label": "自动存档间隔(秒)", "type": "float", "default": 30.0 },
        { "key": "bIsUseBackupSaveData", "group": "基础设置", "label": "启动时使用备份存档", "type": "bool" },

        { "key": "Difficulty", "group": "难度与随机化", "label": "游戏难度", "type": "select", "options": ["None", "Normal", "Difficult"], "default": "None" },
        { "key": "RandomizerType", "group": "难度与随机化", "label": "随机化类型", "type": "select", "options": ["None", "Region", "All"], "default": "None", "note": "需创建新世界才生效" },
        { "key": "RandomizerSeed", "group": "难度与随机化", "label": "随机化种子", "type": "string", "note": "需创建新世界才生效" },
        { "key": "bIsRandomizerPalLevelRandom", "group": "难度与随机化", "label": "帕鲁等级随机", "type": "bool", "note": "需创建新世界才生效" },
        { "key": "DayTimeSpeedRate", "group": "难度与随机化", "label": "白天流速", "type": "float", "default": 1.0 },
        { "key": "NightTimeSpeedRate", "group": "难度与随机化", "label": "夜晚流速", "type": "float", "default": 1.0 },
        { "key": "ExpRate", "group": "难度与随机化", "label": "经验倍率", "type": "float", "default": 1.0 },

        { "key": "PalCaptureRate", "group": "帕鲁", "label": "帕鲁捕获率", "type": "float", "default": 1.0 },
        { "key": "PalSpawnNumRate", "group": "帕鲁", "label": "帕鲁刷新倍率", "type": "float", "default": 1.0, "note": "官方注明：调高会显著增加服务器负载" },
        { "key": "PalDamageRateAttack", "group": "帕鲁", "label": "帕鲁攻击倍率", "type": "float", "default": 1.0, "note": "对所有帕鲁生效（含野生/BOSS）" },
        { "key": "PalDamageRateDefense", "group": "帕鲁", "label": "帕鲁受击倍率", "type": "float", "default": 1.0, "note": "对所有帕鲁生效（含野生/BOSS）；调大=帕鲁受到的伤害更高" },
        { "key": "PalStomachDecreaceRate", "group": "帕鲁", "label": "帕鲁饥饿消耗倍率", "type": "float", "default": 1.0 },
        { "key": "PalStaminaDecreaceRate", "group": "帕鲁", "label": "帕鲁耐力消耗倍率", "type": "float", "default": 1.0 },
        { "key": "PalAutoHPRegeneRate", "group": "帕鲁", "label": "帕鲁HP回复倍率", "type": "float", "default": 1.0 },
        { "key": "PalAutoHpRegeneRateInSleep", "group": "帕鲁", "label": "帕鲁睡眠HP回复倍率", "type": "float", "default": 1.0, "note": "在帕鲁箱或床上睡觉时" },
        { "key": "WorkSpeedRate", "group": "帕鲁", "label": "工作速度倍率", "type": "float", "default": 1.0 },
        { "key": "MonsterFarmActionSpeedRate", "group": "帕鲁", "label": "牧场产出速度倍率", "type": "float", "default": 1.0 },
        { "key": "PalEggDefaultHatchingTime", "group": "帕鲁", "label": "帕鲁蛋孵化时间(小时)", "type": "float", "default": 1.0, "note": "以巨大蛋为基准，其他蛋按比例缩短；0=立即孵化" },
        { "key": "bActiveUNKO", "group": "帕鲁", "label": "帕鲁产生粪便", "type": "bool" },
        { "key": "DropItemMaxNum_UNKO", "group": "帕鲁", "label": "世界内粪便数量上限", "type": "int", "default": 100 },
        { "key": "bEnableInvaderEnemy", "group": "帕鲁", "label": "启用袭击事件", "type": "bool" },
        { "key": "EnablePredatorBossPal", "group": "帕鲁", "label": "启用掠食者BOSS", "type": "bool" },
        { "key": "bPalLost", "group": "帕鲁", "label": "帕鲁濒死永久丢失", "type": "bool" },

        { "key": "PlayerDamageRateAttack", "group": "玩家", "label": "玩家攻击倍率", "type": "float", "default": 1.0 },
        { "key": "PlayerDamageRateDefense", "group": "玩家", "label": "玩家受击倍率", "type": "float", "default": 1.0, "note": "调大=受到的伤害更高；想减伤调小（如0.5）" },
        { "key": "PlayerStomachDecreaceRate", "group": "玩家", "label": "玩家饥饿消耗倍率", "type": "float", "default": 1.0 },
        { "key": "PlayerStaminaDecreaceRate", "group": "玩家", "label": "玩家耐力消耗倍率", "type": "float", "default": 1.0 },
        { "key": "PlayerAutoHPRegeneRate", "group": "玩家", "label": "玩家HP回复倍率", "type": "float", "default": 1.0 },
        { "key": "PlayerAutoHpRegeneRateInSleep", "group": "玩家", "label": "玩家睡眠HP回复倍率", "type": "float", "default": 1.0 },
        { "key": "ItemWeightRate", "group": "玩家", "label": "物品重量倍率", "type": "float", "default": 1.0, "note": "0=物品无重量" },
        { "key": "EquipmentDurabilityDamageRate", "group": "玩家", "label": "装备耐久消耗倍率", "type": "float", "default": 1.0, "note": "0=装备不耗耐久" },
        { "key": "bEnableAimAssistPad", "group": "玩家", "label": "手柄瞄准辅助", "type": "bool" },
        { "key": "bEnableAimAssistKeyboard", "group": "玩家", "label": "键鼠瞄准辅助", "type": "bool" },

        { "key": "bAllowEnhanceStat_Health", "group": "升级属性加点", "label": "升级可加点HP", "type": "bool" },
        { "key": "bAllowEnhanceStat_Attack", "group": "升级属性加点", "label": "升级可加点攻击", "type": "bool" },
        { "key": "bAllowEnhanceStat_Stamina", "group": "升级属性加点", "label": "升级可加点耐力", "type": "bool" },
        { "key": "bAllowEnhanceStat_Weight", "group": "升级属性加点", "label": "升级可加点负重", "type": "bool" },
        { "key": "bAllowEnhanceStat_WorkSpeed", "group": "升级属性加点", "label": "升级可加点工作速度", "type": "bool" },

        { "key": "CollectionDropRate", "group": "采集与掉落", "label": "采集掉落倍率", "type": "float", "default": 1.0 },
        { "key": "CollectionObjectHpRate", "group": "采集与掉落", "label": "采集点HP倍率", "type": "float", "default": 1.0 },
        { "key": "CollectionObjectRespawnSpeedRate", "group": "采集与掉落", "label": "采集点刷新间隔倍率", "type": "float", "default": 1.0, "note": "调小=刷新更快；0=立即刷新" },
        { "key": "EnemyDropItemRate", "group": "采集与掉落", "label": "敌人掉落倍率", "type": "float", "default": 1.0 },
        { "key": "DropItemMaxNum", "group": "采集与掉落", "label": "掉落物上限", "type": "int", "default": 3000 },
        { "key": "DropItemAliveMaxHours", "group": "采集与掉落", "label": "掉落物保留时长(小时)", "type": "float", "default": 1.0 },
        { "key": "PhysicsActiveDropItemMaxNum", "group": "采集与掉落", "label": "物理掉落物上限", "type": "int", "default": -1, "min": -1, "note": "-1=不限制" },
        { "key": "ItemCorruptionMultiplier", "group": "采集与掉落", "label": "物品腐坏速度倍率", "type": "float", "default": 1.0, "note": "0=不腐坏" },

        { "key": "DeathPenalty", "group": "死亡与重生", "label": "死亡惩罚", "type": "select", "options": ["None", "Item", "ItemAndEquipment", "All"], "default": "Item", "note": "None=不掉落；Item=掉物品；ItemAndEquipment=物品+装备；All=全掉含帕鲁" },
        { "key": "bEnableNonLoginPenalty", "group": "死亡与重生", "label": "长时间未登录惩罚", "type": "bool" },
        { "key": "bExistPlayerAfterLogout", "group": "死亡与重生", "label": "登出后角色留在世界中", "type": "bool" },
        { "key": "BlockRespawnTime", "group": "死亡与重生", "label": "重生冷却时间(秒)", "type": "float", "default": 5.0 },
        { "key": "RespawnPenaltyDurationThreshold", "group": "死亡与重生", "label": "重生惩罚触发阈值(秒)", "type": "float", "default": 0.0, "note": "重生后该时间内再次死亡，冷却时间×倍率" },
        { "key": "RespawnPenaltyTimeScale", "group": "死亡与重生", "label": "重生冷却惩罚倍率", "type": "float", "default": 2.0 },
        { "key": "bHardcore", "group": "死亡与重生", "label": "硬核模式", "type": "bool", "note": "玩家死亡后无法重生（角色永久丢失）" },
        { "key": "bCharacterRecreateInHardcore", "group": "死亡与重生", "label": "硬核模式可重建角色", "type": "bool" },

        { "key": "bIsPvP", "group": "PvP", "label": "PvP模式", "type": "bool" },
        { "key": "bEnablePlayerToPlayerDamage", "group": "PvP", "label": "玩家间伤害", "type": "bool" },
        { "key": "bEnableFriendlyFire", "group": "PvP", "label": "友军伤害", "type": "bool" },
        { "key": "bCanPickupOtherGuildDeathPenaltyDrop", "group": "PvP", "label": "可拾取他人工会死亡掉落", "type": "bool" },
        { "key": "bAdditionalDropItemWhenPlayerKillingInPvPMode", "group": "PvP", "label": "PvP击杀额外掉落开关", "type": "bool" },
        { "key": "AdditionalDropItemWhenPlayerKillingInPvPMode", "group": "PvP", "label": "PvP击杀额外掉落物品ID", "type": "string" },
        { "key": "AdditionalDropItemNumWhenPlayerKillingInPvPMode", "group": "PvP", "label": "PvP击杀额外掉落数量", "type": "int", "default": 1 },
        { "key": "bDisplayPvPItemNumOnWorldMap_BaseCamp", "group": "PvP", "label": "地图显示据点PvP物品数", "type": "bool" },
        { "key": "bDisplayPvPItemNumOnWorldMap_Player", "group": "PvP", "label": "地图显示玩家位置与PvP物品数", "type": "bool" },

        { "key": "GuildPlayerMaxNum", "group": "工会与据点", "label": "工会人数上限", "type": "int", "default": 20 },
        { "key": "bAutoResetGuildNoOnlinePlayers", "group": "工会与据点", "label": "自动解散无人在线工会", "type": "bool" },
        { "key": "AutoResetGuildTimeNoOnlinePlayers", "group": "工会与据点", "label": "工会无人自动解散时间(小时)", "type": "float", "default": 72.0 },
        { "key": "GuildRejoinCooldownMinutes", "group": "工会与据点", "label": "重新加入工会冷却(分钟)", "type": "int", "default": 0 },
        { "key": "AutoTransferMasterCheckIntervalSeconds", "group": "工会与据点", "label": "会长自动转让检查间隔(秒)", "type": "float", "default": 3600.0 },
        { "key": "AutoTransferMasterThresholdDays", "group": "工会与据点", "label": "会长离线自动转让阈值(天)", "type": "int", "default": 14 },
        { "key": "MaxGuildsPerFrame", "group": "工会与据点", "label": "每帧处理工会上限", "type": "int", "default": 10, "note": "性能参数，不建议修改" },
        { "key": "BaseCampMaxNum", "group": "工会与据点", "label": "全服据点总上限", "type": "int", "default": 128 },
        { "key": "BaseCampMaxNumInGuild", "group": "工会与据点", "label": "每个工会据点上限", "type": "int", "default": 4 },
        { "key": "BaseCampWorkerMaxNum", "group": "工会与据点", "label": "据点工作帕鲁上限", "type": "int", "default": 15, "note": "官方已知问题：调大可能不生效" },
        { "key": "bEnableDefenseOtherGuildPlayer", "group": "工会与据点", "label": "据点帕鲁攻击他工会玩家", "type": "bool" },
        { "key": "bInvisibleOtherGuildBaseCampAreaFX", "group": "工会与据点", "label": "隐藏他工会据点范围特效", "type": "bool" },
        { "key": "bAllowGlobalPalboxExport", "group": "工会与据点", "label": "允许全球帕鲁盒导出", "type": "bool" },
        { "key": "bAllowGlobalPalboxImport", "group": "工会与据点", "label": "允许全球帕鲁盒导入", "type": "bool" },

        { "key": "BuildObjectHpRate", "group": "建筑", "label": "建筑HP倍率", "type": "float", "default": 1.0 },
        { "key": "BuildObjectDamageRate", "group": "建筑", "label": "建筑受击倍率", "type": "float", "default": 1.0 },
        { "key": "BuildObjectDeteriorationDamageRate", "group": "建筑", "label": "建筑自然劣化倍率", "type": "float", "default": 1.0 },
        { "key": "MaxBuildingLimitNum", "group": "建筑", "label": "每人建筑数量上限", "type": "int", "default": 0, "note": "0=不限制" },
        { "key": "bBuildAreaLimit", "group": "建筑", "label": "启用禁建区(出生点/传送点禁建)", "type": "bool" },
        { "key": "bEnableBuildingPlayerUIdDisplay", "group": "建筑", "label": "建筑显示建造者ID", "type": "bool" },
        { "key": "BuildingNameDisplayCacheTTLSeconds", "group": "建筑", "label": "建筑名缓存时间(秒)", "type": "int", "default": 60 },

        { "key": "bEnableFastTravel", "group": "移动与传送", "label": "启用快速传送", "type": "bool" },
        { "key": "bEnableFastTravelOnlyBaseCamp", "group": "移动与传送", "label": "快速传送仅限据点之间", "type": "bool" },
        { "key": "bIsStartLocationSelectByMap", "group": "移动与传送", "label": "地图上选择出生点", "type": "bool" },

        { "key": "bEnableVoiceChat", "group": "语音", "label": "启用语音聊天", "type": "bool" },
        { "key": "VoiceChatMaxVolumeDistance", "group": "语音", "label": "语音最大音量距离", "type": "float", "default": 3000.0 },
        { "key": "VoiceChatZeroVolumeDistance", "group": "语音", "label": "语音归零距离", "type": "float", "default": 15000.0 },

        { "key": "bIsMultiplay", "group": "高级(不建议修改)", "label": "多人模式", "type": "bool", "note": "专用服务器请勿修改" },
        { "key": "SupplyDropSpan", "group": "高级(不建议修改)", "label": "空投/陨石间隔(分钟)", "type": "int", "default": 180 },
        { "key": "ServerReplicatePawnCullDistance", "group": "高级(不建议修改)", "label": "网络同步剔除距离", "type": "float", "default": 15000.0, "note": "高级参数，不建议修改" },
        { "key": "ItemContainerForceMarkDirtyInterval", "group": "高级(不建议修改)", "label": "容器强制同步间隔(秒)", "type": "float", "default": 1.0, "note": "高级参数，不建议修改" },
        { "key": "PlayerDataPalStorageUpdateCheckTickInterval", "group": "高级(不建议修改)", "label": "帕鲁存储检查间隔(秒)", "type": "float", "default": 1.0, "note": "高级参数，不建议修改" }
      ]
    }
  ],
  "backup_paths": ["Pal/Saved"],
  "world_paths": ["Pal/Saved/SaveGames"],
  "notes": "内存需求高（官方建议16G+），务必配置每日定时重启。所有设置（含经验/掉落等倍率）重启服务器即生效，无需新建世界；仅随机化相关（如「帕鲁等级随机」）在创建世界时固化。公网需放行游戏端口 UDP。倍率类参数无官方上下限。CrossplayPlatforms、DenyTechnologyList 为列表型配置，面板不支持编辑，如需修改请直接编辑 PalWorldSettings.ini。"
}
