{
  "id": "ark-se",
  "name": "方舟：生存进化 ARK: SE",
  "description": "ARK: Survival Evolved 专用服务器。内存需求极高（建议 12G+），低配机器请勿尝试。",
  "steam_app_id": 376030,
  "anonymous_login": true,
  "executable": "./ShooterGame/Binaries/Linux/ShooterGameServer",
  "default_args": ["TheIsland?listen?SessionName=MyArkServer?ServerAdminPassword=changeme", "-server", "-log"],
  "stop_mode": "sigterm",
  "stop_warn_secs": 0,
  "ports": [
    { "key": "game", "default": 7777, "proto": "udp", "desc": "游戏端口", "public": true },
    { "key": "query", "default": 27015, "proto": "udp", "desc": "Steam 查询端口", "public": true }
  ],
  "configs": [],
  "backup_paths": ["ShooterGame/Saved"],
  "notes": "本机 4G 内存无法运行此游戏，仅作模板演示。SIGTERM 停止可能丢档，建议先在游戏内用管理员工具 saveworld。模板按官方文档编写，未在本机实测。"
}
